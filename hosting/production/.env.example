# -----------------------------------------------------------------------------
# Colanode - production environment
# Copy to .env and replace every CHANGE_ME value.
# -----------------------------------------------------------------------------

# Images (published by .github/workflows/docker-publish.yml)
# - latest      : last release tag (vX.Y.Z)
# - edge        : last commit on main
# - X.Y.Z       : a specific release (recommended to pin in production)
COLANODE_REGISTRY=ghcr.io/gambsantoine
COLANODE_VERSION=latest

# Public domains (DNS must point to this host so Caddy can issue certificates)
WEB_DOMAIN=colanode.example.com
SERVER_DOMAIN=api.colanode.example.com
# Email used by Let's Encrypt for certificate expiry notices
ACME_EMAIL=admin@example.com

# Display name of the server shown in the clients
SERVER_NAME=Colanode

# PostgreSQL
# Use URL-safe characters only (letters, digits, - _ .): the password is
# embedded in the connection URL. Generate with: openssl rand -hex 32
POSTGRES_USER=colanode
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=colanode

# Valkey (Redis compatible) - URL-safe characters only, see above
VALKEY_PASSWORD=CHANGE_ME
