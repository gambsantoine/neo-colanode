# Copier en .env a cote de docker-compose.yaml : cp env.example .env

# --- Images ---
COLANODE_VERSION=2.0.3

# --- Domaines (DNS pointant vers l'hote Traefik) ---
WEB_DOMAIN=colanode.example.com
SERVER_DOMAIN=api.colanode.example.com
SERVER_NAME=Neo Colanode

# --- Traefik existant ---
# Nom exact du reseau docker de Traefik (docker network ls)
TRAEFIK_NETWORK=CHANGE_ME
# Noms definis dans la config statique de Traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Postgres ---
POSTGRES_USER=colanode
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=colanode

# --- Valkey (Redis) ---
VALKEY_PASSWORD=CHANGE_ME
